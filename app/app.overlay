/ {
    aliases {
        step   = &step_pin;
        dir    = &dir_pin;
        enable = &enable_pin;
    };
    photo_sensor_a: photo_sensor_a {
        gpios = <&gpioe 5 GPIO_ACTIVE_HIGH>;
    };

    /* Parent grouping node for the stepper control signals */
    stepper_motor: stepper_motor {
        compatible = "gpio-leds";
        step_pin: step_pin {
            gpios = <&gpiod 7 GPIO_ACTIVE_HIGH>;
        };
        dir_pin: dir_pin {
            gpios = <&gpiod 6 GPIO_ACTIVE_HIGH>;
        };
        /* ENABLE pin: PA2 */
        enable_pin: enable_pin {
            gpios = <&gpioa 2 GPIO_ACTIVE_HIGH>;
        };

    };
};
&adc3 {
    status = "okay";
    pinctrl-0 = <&adc3_inp5_pf3>;
    pinctrl-names = "default";
    #address-cells = <1>;
    #size-cells = <0>;
    // PF3 - channel 5
    channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <16>;
    };
    // PF5 - channel 4
    channel@4 {
        reg = <4>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <16>;
    };
    // PF7 - channel 3
    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <16>;
    };
    // PF9 - channel 2
    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <16>;
    };
    // PC3_C - channel 1
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <16>;
    };
};




