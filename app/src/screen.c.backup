/*
 * NOTE: Display driver temporarily disabled due to ILI9340 incompatibility.
 * Will implement custom SPI-based display control later.
 * All functions below are commented out.
 */

#if 0  /* Disabled until custom SPI display implementation */

#include <zephyr/kernel.h>
#include <zephyr/device.h>
#include <zephyr/devicetree.h>
#include <zephyr/drivers/display.h>
#include <zephyr/logging/log.h>
#include <string.h>

#include "screen.h"

/* Use the display chosen by the shield/board */
#define DISPLAY_NODE DT_CHOSEN(zephyr_display)

LOG_MODULE_REGISTER(screen, LOG_LEVEL_INF);

static const struct device *display_dev;
static struct display_capabilities caps;

/* Max line width we’ll support (320px, matches Adafruit 2.8" TFT) */
#define SCREEN_MAX_WIDTH 320
static uint16_t line_buf[SCREEN_MAX_WIDTH];

/* Helper: Send command byte */
static void ili9340_cmd(uint8_t cmd)
{
    gpio_pin_set_dt(&dc_pin, 0);  /* Command mode */
    struct spi_buf tx_buf = { .buf = &cmd, .len = 1 };
    struct spi_buf_set tx = { .buffers = &tx_buf, .count = 1 };
    spi_write(spi_dev, &spi_cfg, &tx);
}

/* Helper: Send data byte(s) */
static void ili9340_data(const uint8_t *data, size_t len)
{
    gpio_pin_set_dt(&dc_pin, 1);  /* Data mode */
    struct spi_buf tx_buf = { .buf = (void *)data, .len = len };
    struct spi_buf_set tx = { .buffers = &tx_buf, .count = 1 };
    spi_write(spi_dev, &spi_cfg, &tx);
}

/* Set drawing window */
static void ili9340_set_window(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1)
{
    uint8_t data[4];
    
    /* Column address */
    ili9340_cmd(ILI9340_CASET);
    data[0] = x0 >> 8;
    data[1] = x0 & 0xFF;
    data[2] = x1 >> 8;
    data[3] = x1 & 0xFF;
    ili9340_data(data, 4);
    
    /* Page (row) address */
    ili9340_cmd(ILI9340_PASET);
    data[0] = y0 >> 8;
    data[1] = y0 & 0xFF;
    data[2] = y1 >> 8;
    data[3] = y1 & 0xFF;
    ili9340_data(data, 4);
    
    /* Memory write */
    ili9340_cmd(ILI9340_RAMWR);
}

int screen_init(void)
{
    int ret;

    /* Get SPI device */
    spi_dev = DEVICE_DT_GET(SPI1_NODE);
    if (!device_is_ready(spi_dev)) {
        LOG_ERR("SPI device not ready");
        return -ENODEV;
    }

    /* Configure DC pin */
    if (!device_is_ready(dc_pin.port)) {
        LOG_ERR("DC GPIO not ready");
        return -ENODEV;
    }
    ret = gpio_pin_configure_dt(&dc_pin, GPIO_OUTPUT_INACTIVE);
    if (ret) {
        LOG_ERR("Failed to configure DC pin (%d)", ret);
        return ret;
    }

    /* Configure RST pin */
    if (!device_is_ready(rst_pin.port)) {
        LOG_ERR("RST GPIO not ready");
        return -ENODEV;
    }
    ret = gpio_pin_configure_dt(&rst_pin, GPIO_OUTPUT_ACTIVE);
    if (ret) {
        LOG_ERR("Failed to configure RST pin (%d)", ret);
        return ret;
    }

    /* Hardware reset */
    gpio_pin_set_dt(&rst_pin, 0);
    k_msleep(10);
    gpio_pin_set_dt(&rst_pin, 1);
    k_msleep(120);

    /* Software reset */
    ili9340_cmd(ILI9340_SWRESET);
    k_msleep(150);

    /* Sleep out */
    ili9340_cmd(ILI9340_SLPOUT);
    k_msleep(120);

    /* Pixel format: RGB565 (16-bit) */
    ili9340_cmd(ILI9340_PIXFMT);
    uint8_t pixfmt = 0x55;  /* 16 bits/pixel */
    ili9340_data(&pixfmt, 1);

    /* Memory access control: normal orientation */
    ili9340_cmd(ILI9340_MADCTL);
    uint8_t madctl = 0x48;  /* MY=0, MX=1, MV=0, BGR=1 */
    ili9340_data(&madctl, 1);

    /* Display on */
    ili9340_cmd(ILI9340_DISPON);
    k_msleep(10);

    LOG_INF("ILI9340 initialized (320x240, RGB565)");
    return 0;
}

void screen_fill(uint16_t color)
{
    if (!spi_dev) {
        return;
    }

    /* Set full screen window */
    ili9340_set_window(0, 0, SCREEN_WIDTH - 1, SCREEN_HEIGHT - 1);

    /* Prepare line buffer with the color (swap bytes for RGB565 endianness) */
    uint16_t color_swapped = __builtin_bswap16(color);
    for (uint16_t x = 0; x < SCREEN_WIDTH; x++) {
        line_buf[x] = color_swapped;
    }

    /* Write each line */
    gpio_pin_set_dt(&dc_pin, 1);  /* Data mode */
    for (uint16_t y = 0; y < SCREEN_HEIGHT; y++) {
        struct spi_buf tx_buf = { 
            .buf = line_buf, 
            .len = SCREEN_WIDTH * sizeof(uint16_t) 
        };
        struct spi_buf_set tx = { .buffers = &tx_buf, .count = 1 };
        spi_write(spi_dev, &spi_cfg, &tx);
    }
}

void screen_draw_test_pattern(void)
{
    if (!spi_dev) {
        return;
    }

    /* Set full screen window */
    ili9340_set_window(0, 0, SCREEN_WIDTH - 1, SCREEN_HEIGHT - 1);

    gpio_pin_set_dt(&dc_pin, 1);  /* Data mode */

    /* Simple vertical gradient on blue channel */
    for (uint16_t y = 0; y < SCREEN_HEIGHT; y++) {
        /* Map y (0..height-1) to 0..31 for blue channel */
        uint8_t blue = (y * 31) / (SCREEN_HEIGHT - 1);
        uint16_t color = (blue & 0x1F);  /* RGB565: only blue bits */
        uint16_t color_swapped = __builtin_bswap16(color);

        for (uint16_t x = 0; x < SCREEN_WIDTH; x++) {
            line_buf[x] = color_swapped;
        }

        struct spi_buf tx_buf = { 
            .buf = line_buf, 
            .len = SCREEN_WIDTH * sizeof(uint16_t) 
        };
        struct spi_buf_set tx = { .buffers = &tx_buf, .count = 1 };
        spi_write(spi_dev, &spi_cfg, &tx);
    }
}
